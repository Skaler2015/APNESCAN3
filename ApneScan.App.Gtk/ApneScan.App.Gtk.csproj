<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>ApneScan</RootNamespace>
        <AssemblyName>apnescan</AssemblyName>
        <ApplicationIcon>../ApneScan.Lib/Icons/favicon.ico</ApplicationIcon>

        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>

	<RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>

        <Title>ApneScan - Not Another PDF Scanner</Title>
        <Product>ApneScan - Not Another PDF Scanner</Product>
    </PropertyGroup>

    <Import Project="..\ApneScan.Setup\targets\CommonTargets.targets" />
    <Import Project="..\ApneScan.Setup\targets\SdkUsers.targets" />

    <ItemGroup>
        <PackageReference Include="ApneScan.Pdfium.Binaries" Version="1.3.0" />
        <PackageReference Include="ApneScan.Tesseract.Binaries" Version="1.4.0" />

        <ProjectReference Include="..\ApneScan.Lib.Gtk\ApneScan.Lib.Gtk.csproj" />

        <PackageReference Include="Eto.Platform.Gtk" Version="2.11.0" />
        <!-- This shouldn't need a reference normally, but otherwise "dotnet restore" doesn't pick
             it up, which breaks the flatpak build. -->
        <PackageReference Include="Microsoft.NETCore.App" Version="2.1.*" />
    </ItemGroup>

    <ItemGroup>
        <ContentWithTargetPath Include="..\ApneScan.Setup\appsettings.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <Link>appsettings.xml</Link>
            <TargetPath>appsettings.xml</TargetPath>
        </ContentWithTargetPath>
    </ItemGroup>
</Project>
