<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <LargeAddressAware>true</LargeAddressAware>
    <RootNamespace>ApneScan.Worker</RootNamespace>
    <AssemblyName>ApneScan.Worker</AssemblyName>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <Title>ApneScan - Not Another PDF Scanner</Title>
    <Product>ApneScan - Not Another PDF Scanner</Product>
  </PropertyGroup>

  <Import Project="..\ApneScan.Setup\targets\CommonTargets.targets" />
  <Import Project="..\ApneScan.Setup\targets\NativeLibs.targets" />
  <Import Project="..\ApneScan.Setup\targets\SdkUsers.targets" />

  <ItemGroup>
    <PackageReference Include="Ben.Demystifier" Version="0.4.1" />
    <PackageReference Include="LargeAddressAware" Version="1.0.6" />
    <PackageReference Include="NLog" Version="5.5.1" />
    <PackageReference Include="NLog.Extensions.Logging" Version="5.5.0" />

    <ProjectReference Include="..\ApneScan.Images.Gdi\ApneScan.Images.Gdi.csproj" />
    <ProjectReference Include="..\ApneScan.Sdk\ApneScan.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../ApneScan.Lib/Paths.cs" />
    <Compile Include="../ApneScan.Lib/NLogConfig.cs" />
    <Compile Include="../ApneScan.Lib/EntryPoints/CoreWorkerEntryPoint.cs" />
  </ItemGroup>
</Project>