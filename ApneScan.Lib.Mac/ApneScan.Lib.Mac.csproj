<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-macos</TargetFrameworks>
        <Nullable>enable</Nullable>
        <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
        <RootNamespace>ApneScan</RootNamespace>

        <Title>ApneScan - Not Another PDF Scanner</Title>
        <Product>ApneScan - Not Another PDF Scanner</Product>
    </PropertyGroup>

    <Import Project="..\ApneScan.Setup\targets\CommonTargets.targets" />
    <Import Project="..\ApneScan.Setup\targets\LibUsers.targets" />

    <ItemGroup>
        <ProjectReference Include="..\ApneScan.Images.Mac\ApneScan.Images.Mac.csproj" />
        <ProjectReference Include="..\ApneScan.Lib\ApneScan.Lib.csproj" />
        <PackageReference Include="Eto.Platform.macOS" Version="2.11.0" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ApneScan.Lib.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <Using Include="ObjCRuntime" />
        <Using Include="AppKit" />
        <Using Include="CoreGraphics" />
        <Using Include="Foundation" />
        <Using Include="System.Runtime.InteropServices" />
    </ItemGroup>

</Project>