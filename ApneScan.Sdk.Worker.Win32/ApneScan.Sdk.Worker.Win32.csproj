<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net462;net8;net10.0</TargetFrameworks>
        <RootNamespace>ApneScan.Sdk.Worker</RootNamespace>
        <AssemblyName>ApneScan.Sdk.Worker.Win32</AssemblyName>

        <Title>ApneScan.Sdk.Worker.Win32</Title>
        <Product>ApneScan.Sdk.Worker.Win32</Product>
        <Description>Windows 32-bit (x86) worker process for ApneScan.Sdk</Description>
        <PackageTags>apnescan</PackageTags>

    </PropertyGroup>

    <Import Project="..\ApneScan.Setup\targets\CommonTargets.targets" />
    <Import Project="..\ApneScan.Setup\targets\SdkPackageTargets.targets" />

    <ItemGroup>
        <Content Include="ApneScan.Sdk.Worker.Win32.targets" PackagePath="build/ApneScan.Sdk.Worker.Win32.targets" />
        <None Include="..\ApneScan.Sdk.Worker.Build\bin\Release\net10.0\win-x86\publish\ApneScan.Worker.exe">
            <Link>lib/ApneScan.Worker.exe</Link>
            <Pack>true</Pack>
            <PackageCopyToOutput>true</PackageCopyToOutput>
            <PackagePath>contentFiles</PackagePath>
        </None>
    </ItemGroup>
</Project>
