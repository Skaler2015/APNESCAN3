%define        __spec_install_post %{nil}
%define          debug_package %{nil}
%define        __os_install_post %{_dbpath}/brp-compress

Summary: Scan documents to PDF and more, as simply as possible.
Name: apnescan
Version: {!version}
Release: 1
License: GPLv2+
Group: Graphics
SOURCE0: %{name}-%{version}.tar.gz
URL: https://www.apnescan.com/
AutoReqProv: no

BuildRoot: %{_tmppath}/%{name}-%{version}-%{release}-root

%description
%{summary}

%prep
%setup -q

%build
# Empty section.

%install
rm -rf %{buildroot}
mkdir -p  %{buildroot}

# in builddir
cp -a * %{buildroot}


%clean
rm -rf %{buildroot}


%files
%defattr(-,root,root,-)
/usr/lib/apnescan/*
/usr/bin/apnescan
/usr/share/applications/apnescan.desktop
/usr/share/icons/hicolor/128x128/apps/com.apnescan.ApneScan.png
/usr/share/metainfo/com.apnescan.ApneScan.metainfo.xml