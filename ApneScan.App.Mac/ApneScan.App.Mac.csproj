<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ApneScan</RootNamespace>
    <AssemblyName>ApneScan</AssemblyName>
    <ApplicationIcon>../ApneScan.Lib/Icons/favicon.ico</ApplicationIcon>

    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-x64;osx-arm64</RuntimeIdentifiers>
    <TrimMode>partial</TrimMode>

    <Title>ApneScan - Not Another PDF Scanner</Title>
    <Product>ApneScan - Not Another PDF Scanner</Product>
  </PropertyGroup>

  <Import Project="..\ApneScan.Setup\targets\CommonTargets.targets" />
  <Import Project="..\ApneScan.Setup\targets\SdkUsers.targets" />
  
  <ItemGroup>
    <PackageReference Include="NAPS2.Pdfium.Binaries" Version="1.3.0" />
    <PackageReference Include="NAPS2.Sane.Binaries" Version="1.2.1" />
    <PackageReference Include="NAPS2.Tesseract.Binaries" Version="1.4.0" />

    <ProjectReference Include="..\ApneScan.Lib.Mac\ApneScan.Lib.Mac.csproj" />

    <PackageReference Include="Eto.Platform.macOS" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\ApneScan.Setup\appsettings.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>appsettings.xml</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Icon.icns" />
  </ItemGroup>
</Project>