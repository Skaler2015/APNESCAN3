<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net462;net8-windows;net10.0-windows</TargetFrameworks>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>ApneScan.Images.Wpf</RootNamespace>
        <UseWpf>true</UseWpf>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>

        <Title>ApneScan.Images.Wpf</Title>
        <Product>ApneScan.Images.Wpf</Product>
        <Description>Images based on WPF for ApneScan.Sdk.</Description>
        <PackageTags>apnescan</PackageTags>
    </PropertyGroup>

    <Import Project="..\ApneScan.Setup\targets\SdkPackageTargets.targets" />

    <ItemGroup>
        <ProjectReference Include="..\ApneScan.Images\ApneScan.Images.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ApneScan.Sdk.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <Import Project="..\ApneScan.Setup\targets\CommonTargets.targets" />
    <Import Project="..\ApneScan.Setup\targets\ImageUsers.targets" />

</Project>
