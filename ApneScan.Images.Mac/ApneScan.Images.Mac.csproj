<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8;net10.0;net10.0-macos</TargetFrameworks>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <RootNamespace>ApneScan.Images.Mac</RootNamespace>

        <Title>ApneScan.Images.Mac</Title>
        <Product>ApneScan.Images.Mac</Product>
        <Description>Images based on AppKit.NSImage for ApneScan.Sdk.</Description>
        <PackageTags>apnescan</PackageTags>
    </PropertyGroup>

    <Import Project="..\ApneScan.Setup\targets\SdkPackageTargets.targets" />

    <ItemGroup>
        <ProjectReference Include="..\ApneScan.Images\ApneScan.Images.csproj" />
    </ItemGroup>

    <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0-macos'">
        <DefineConstants>MONOMAC</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-macos'">
        <Using Include="MonoMac.AppKit" />
        <Using Include="MonoMac.CoreGraphics" />
        <Using Include="MonoMac.Foundation" />
        <Using Include="MonoMac.ImageIO" />
        <Using Include="MonoMac.MobileCoreServices" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
        <Using Include="AppKit" />
        <Using Include="CoreGraphics" />
        <Using Include="Foundation" />
        <Using Include="ImageIO" />
        <Using Include="MobileCoreServices" />
        <Using Include="System.Runtime.InteropServices" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ApneScan.Sdk.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
      <PackageReference Include="Eto.Platform.Mac64" Version="2.11.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8'">
      <PackageReference Include="Eto.Platform.Mac64" Version="2.11.0" />
    </ItemGroup>

    <Import Project="..\ApneScan.Setup\targets\CommonTargets.targets" />
    <Import Project="..\ApneScan.Setup\targets\ImageUsers.targets" />

</Project>
